{
  "info": {
    "name": "Elderly - API 08 - Cadastro de Medicamento (Token Falso) - Guilherme",
    "description": "POST /medicamentos - Particionamento de Equivalencia de Acesso (token valido x token falso).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Setup - Login para obter token",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@elderly.com\",\n  \"senha\": \"123456\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);",
              "pm.test(\"Login de setup OK (200)\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "CT01 - P1 Token valido",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/medicamentos", "host": [ "{{baseUrl}}" ], "path": [ "medicamentos" ] },
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Dipirona\",\n  \"dosagem\": \"500mg\",\n  \"quantidade\": 20,\n  \"data_compra\": \"2026-06-02\",\n  \"data_validade\": \"2028-06-02\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Mensagem de sucesso\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.mensagem).to.eql('Medicamento registrado com sucesso');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "CT02 - P2 Token falso",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer TokenFalsoDaSilva" }
        ],
        "url": { "raw": "{{baseUrl}}/medicamentos", "host": [ "{{baseUrl}}" ], "path": [ "medicamentos" ] },
        "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Dipirona\",\n  \"dosagem\": \"500mg\",\n  \"quantidade\": 20,\n  \"data_compra\": \"2026-06-02\",\n  \"data_validade\": \"2028-06-02\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Erro deve ser 'Token invalido'\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.erro).to.eql('Token inválido');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
