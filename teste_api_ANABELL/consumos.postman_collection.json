{
  "info": {
    "name": "Elderly - API 05 - Consumos (Token Invalido) - Anabell",
    "description": "POST /consumos - Particionamento de Equivalencia (consumo valido x token invalido).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Setup - Login para obter token",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@elderly.com\",\n  \"senha\": \"123456\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);",
              "pm.test(\"Login de setup OK (200)\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "CT01 - P1 Consumo valido",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/consumos", "host": [ "{{baseUrl}}" ], "path": [ "consumos" ] },
        "body": { "mode": "raw", "raw": "{\n  \"medicamento_id\": 1,\n  \"quantidade_consumida\": 1\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Mensagem de consumo registrado\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.mensagem).to.eql('Consumo registrado e estoque atualizado');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "CT02 - P2 Token invalido",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer TokenFalsoDaSilva" }
        ],
        "url": { "raw": "{{baseUrl}}/consumos", "host": [ "{{baseUrl}}" ], "path": [ "consumos" ] },
        "body": { "mode": "raw", "raw": "{\n  \"medicamento_id\": 1,\n  \"quantidade_consumida\": 1\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Erro deve ser 'Token invalido'\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.erro).to.eql('Token inválido');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
