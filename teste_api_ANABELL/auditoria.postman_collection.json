{
  "info": {
    "name": "Elderly - API 06 - Auditoria - Anabell",
    "description": "GET /admin/auditoria - Particionamento de Equivalencia de Acesso (com token x sem token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Setup - Login para obter token",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"ana@elderly.com\",\n  \"senha\": \"123456\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);",
              "pm.test(\"Login de setup OK (200)\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "CT01 - P1 Auditoria com token valido",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/admin/auditoria", "host": [ "{{baseUrl}}" ], "path": [ "admin", "auditoria" ] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"A resposta deve ser uma lista (historico)\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "CT02 - P2 Sem token",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/admin/auditoria", "host": [ "{{baseUrl}}" ], "path": [ "admin", "auditoria" ] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Erro deve ser 'Token nao fornecido'\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.erro).to.eql('Token não fornecido');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
